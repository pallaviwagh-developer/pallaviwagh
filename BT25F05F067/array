#include <iostream>
using namespace std;

#define MAX 5

int stack[MAX];
int top = -1;

// Push operation
void push(int x)
{
    if (top == MAX - 1)
        cout << "Stack Overflow\n";
    else
        stack[++top] = x;
}

// Pop operation
void pop()
{
    if (top == -1)
        cout << "Stack Underflow\n";
    else
        cout << "Popped: " << stack[top--] << endl;
}

// Display operation
void display()
{
    if (top == -1)
        cout << "Stack is Empty\n";
    else
    {
        cout << "Stack elements are:\n";
        for (int i = top; i >= 0; i--)
            cout << stack[i] << endl;
    }
}

int main()
{
    push(10);
    push(20);
    push(30);

    display();

    pop();
    display();

    return 0;
}